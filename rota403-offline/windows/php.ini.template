; php.ini do Rota 403 — gerado pelo instalador (valores @...@ são substituídos)
[PHP]
engine=On
short_open_tag=Off
memory_limit=256M
max_execution_time=60
max_input_time=60
post_max_size=16M
upload_max_filesize=8M
max_file_uploads=5
expose_php=Off
display_errors=Off
display_startup_errors=Off
log_errors=On
error_log="@DATADIR@\logs\php-error.log"
error_reporting=E_ALL
date.timezone="America/Sao_Paulo"
default_charset="UTF-8"
extension_dir="@PHPDIR@\ext"
cgi.fix_pathinfo=1
cgi.force_redirect=0
fastcgi.impersonate=0
session.save_path="@DATADIR@\sessions"
session.use_strict_mode=1
session.cookie_httponly=1
session.cookie_samesite=Lax
upload_tmp_dir="@DATADIR@\tmp"
sys_temp_dir="@DATADIR@\tmp"
allow_url_fopen=Off
allow_url_include=Off
; Extensões habilitadas (somente as usadas): banco, texto, TLS/HMAC/cifra, imagem da logo, sync HTTP, iconv
extension=pdo_mysql
extension=mbstring
extension=openssl
extension=curl
extension=gd
extension=fileinfo
extension=intl
extension=iconv
[Date]
date.timezone="America/Sao_Paulo"
