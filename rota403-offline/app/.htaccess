Options -Indexes -MultiViews
DirectoryIndex index.php

# Bloqueia acesso direto a configuração, includes e ao arquivo SQL
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(config|includes|tests|QZ_WINDOWS|ATALHO_CHROME)/ - [F,L,NC]
  RewriteRule \.sql$ - [F,L]
  # Arquivos ocultos (.git, .env...) e scripts internos de impressão sem login
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^imprimir/_base(\.php)?$ - [F,L,NC]

  # Canonicaliza somente navegação GET/HEAD. POST antigo mantém corpo e CSRF.
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s/+([^?\ ]+?)\.php(?:[?\ ]|$) [NC]
  RewriteRule ^(.+)\.php$ /%1 [R=302,L,NE]

  # Arquivos e diretórios existentes (fotos, scripts etc.) não são reescritos.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [END]
</IfModule>
<FilesMatch "\.(sql|md|txt|pem|crt|key|bat|ps1|ini|log|bak|old|swp|py|sh)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
  Header unset X-Powered-By
</IfModule>
