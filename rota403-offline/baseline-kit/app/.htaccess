Options -Indexes
DirectoryIndex index.php

# Bloqueia acesso direto a configuração, includes e ao arquivo SQL
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(config|includes)/ - [F,L]
  RewriteRule \.sql$ - [F,L]
</IfModule>
<FilesMatch "\.(sql|md|txt)$">
  Require all denied
</FilesMatch>
